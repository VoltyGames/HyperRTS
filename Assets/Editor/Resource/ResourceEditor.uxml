<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
>
    <Style src="project://database/Assets/Editor/ResourcesEditor.uss?fileID=7433441132597879392&amp;guid=9d896348b1a4c7a43a301d69d4c30725&amp;type=3#ResourcesEditor" />

    <ui:VisualElement>
	    <ui:Label text="Resource Manager" class="header" />
	    <ui:VisualElement>
		    <ui:Label text="Register New Resource:" />
		    <ui:TextField name="resourceNameField" label="Resource Name" />
		    <ui:Button name="addResourceButton" text="Add Resource" />
	    </ui:VisualElement>
        
	    <ui:VisualElement>
		    <ui:Label text="Registered Resources:" />
		    <ui:ScrollView name="resourceList" />
	    </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
