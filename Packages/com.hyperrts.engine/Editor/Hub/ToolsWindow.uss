/* The Tools window: sidebar, badges and the page host. Colour tokens are in Common/HyperRTSEditor.uss. */

.hrts-tools {
    flex-direction: row;
    flex-grow: 1;
}

.hrts-sidebar {
    width: 160px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-color: var(--hrts-border);
}

.hrts-sidebar__item {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding: 0 6px;
}

.hrts-sidebar__title {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
}

.hrts-badge {
    min-width: 16px;
    height: 16px;
    padding: 0 5px;
    border-radius: 8px;
    background-color: rgb(196, 64, 56);
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hrts-page-host {
    flex-grow: 1;
    flex-shrink: 1;
}

.hrts-page {
    flex-grow: 1;
}

.hrts-page__body {
    padding: 4px;
}
