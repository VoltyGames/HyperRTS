/* Inspector extras: the entity summary, the issue badge and producible options. Colour tokens are in Common/HyperRTSEditor.uss. */

.hrts-summary {
    margin: 0 0 4px 0;
}

.hrts-issue-badge {
    margin: 0 0 4px 0;
}

.hrts-issue-badge__button {
    flex-direction: row;
    align-self: flex-start;
    margin: 0;
    padding: 1px 6px;
    border-radius: 8px;
}

.hrts-issue-badge__button--open {
    border-color: rgb(120, 120, 120);
}

.hrts-issue-badge__count {
    -unity-font-style: bold;
    margin: 0 3px;
    padding: 0;
}

.hrts-issue-badge__errors {
    color: var(--hrts-error);
}

.hrts-issue-badge__warnings {
    color: var(--hrts-warning);
}

.hrts-issue-badge__notes {
    color: rgb(150, 190, 255);
}

.hrts-option {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.hrts-option__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
}

.hrts-option__icon {
    width: 18px;
    height: 18px;
    margin: 0 4px;
    flex-shrink: 0;
}

.hrts-option__summary {
    width: 45%;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    color: var(--hrts-dim-text);
    font-size: 10px;
}
