/* The Cheats and Debug windows. The debug panel is styled in DebugPanel.uss. */

.hrts-play-window {
  flex-grow: 1;
}

.hrts-play-window > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
  padding: 4px 6px 6px 6px;
}

.hrts-play-window__match {
  margin: 2px 3px 4px 3px;
  color: var(--hrts-dim-text);
}

/* A section heading: bold, with a rule above all but the first. */
.hrts-group {
  margin-top: 2px;
  padding-top: 2px;
  border-top-width: 1px;
  border-color: var(--hrts-border);
}

.hrts-group > .unity-foldout__toggle .unity-foldout__text {
  -unity-font-style: bold;
}

.hrts-group > .unity-foldout__content {
  margin-left: 4px;
}

.hrts-group > .unity-foldout__toggle .hrts-glyph {
  margin: 0 4px 0 2px;
}

.hrts-cheats__picker {
  -unity-text-align: middle-left;
}

.hrts-cheats__count {
  width: 48px;
}

/* A long title shrinks to an ellipsis so it never runs under the status. */
.hrts-strike__title {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  margin-left: 3px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hrts-strike__status {
  flex-shrink: 0;
  margin: 0 4px;
}

.hrts-strike > .unity-button {
  flex-shrink: 0;
}

.hrts-strike__heading {
  -unity-font-style: bold;
  margin: 4px 0 1px 2px;
}
