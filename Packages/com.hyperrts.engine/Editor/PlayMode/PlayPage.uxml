<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
  <ui:Template name="CheatsSection" src="CheatsSection.uxml" />
  <HyperRTS.Editor.Hub.PageShell name="shell" empty-text="Enter Play mode to use cheats, networking and recording.">
    <ui:Instance template="CheatsSection" name="cheats" />
    <HyperRTS.Editor.Common.TitledSection title="Network">
      <ui:VisualElement class="hrts-buttons">
        <ui:Button name="host" text="Host" />
        <ui:Button name="join" text="Join Localhost" />
        <ui:Button name="server" text="Dedicated Server" />
        <ui:Button name="stop" text="Stop" />
      </ui:VisualElement>
      <ui:Label name="traffic" class="hrts-note" />
    </HyperRTS.Editor.Common.TitledSection>
    <HyperRTS.Editor.Common.TitledSection title="Bot matches">
      <uie:PropertyField binding-path="bots.matches" label="Matches" />
      <uie:PropertyField binding-path="bots.players" label="Players" />
      <uie:PropertyField binding-path="bots.difficulty" label="Difficulty" />
      <uie:PropertyField binding-path="bots.speed" label="Game speed" />
      <uie:PropertyField binding-path="bots.timeLimitMinutes" label="Time limit (min)" />
      <ui:VisualElement class="hrts-buttons">
        <ui:Button name="run-bots" text="Run" />
        <ui:Button name="stop-bots" text="Stop" />
      </ui:VisualElement>
      <ui:Label name="bot-status" class="hrts-note" />
    </HyperRTS.Editor.Common.TitledSection>
    <HyperRTS.Editor.Common.TitledSection title="Replays">
      <ui:VisualElement class="hrts-buttons">
        <ui:Button name="save" text="Save Recording..." />
        <ui:Button name="play" text="Play Replay..." />
      </ui:VisualElement>
    </HyperRTS.Editor.Common.TitledSection>
  </HyperRTS.Editor.Hub.PageShell>
</ui:UXML>
