/* The Cheats & Debug window. Its debug section is styled in DebugSection.uss. */

.hrts-cheats-debug {
  flex-grow: 1;
}

.hrts-cheats-debug > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
  padding: 4px 6px 6px 6px;
}

.hrts-cheats-debug__match {
  white-space: normal;
  margin: 2px 3px 4px 3px;
  color: var(--hrts-dim-text);
}

/* A section heading: bold, with a rule above all but the first. */
.hrts-group {
  margin-top: 2px;
  padding-top: 2px;
  border-top-width: 1px;
  border-color: var(--hrts-border);
}

.hrts-group > .unity-foldout__toggle .unity-foldout__text {
  -unity-font-style: bold;
}

.hrts-group > .unity-foldout__content {
  margin-left: 4px;
}

.hrts-cheats__picker {
  -unity-text-align: middle-left;
}

.hrts-cheats__count {
  width: 48px;
}
