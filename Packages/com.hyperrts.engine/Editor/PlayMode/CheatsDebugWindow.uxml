<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
  <Style src="../Common/HyperRTSEditor.uss" />
  <Style src="CheatsDebugWindow.uss" />
  <ui:Template name="CheatsSection" src="CheatsSection.uxml" />
  <ui:Template name="DebugSection" src="DebugSection.uxml" />
  <ui:ScrollView class="hrts-cheats-debug">
    <ui:Label name="match" class="hrts-cheats-debug__match" />
    <ui:Instance template="CheatsSection" name="cheats" />
    <ui:Instance template="DebugSection" name="debug" />
  </ui:ScrollView>
</ui:UXML>
