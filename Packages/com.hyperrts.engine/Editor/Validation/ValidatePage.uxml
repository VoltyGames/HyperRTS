<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
  <HyperRTS.Editor.Hub.PageShell name="shell" scroll="false">
    <uie:Toolbar>
      <uie:ToolbarButton name="validate" text="Validate" />
      <uie:ToolbarToggle name="selection-only" text="Selection only" binding-path="validateSelectionOnly" />
      <uie:ToolbarSpacer class="hrts-fill" />
      <ui:Label name="counts" class="hrts-toolbar-label" />
    </uie:Toolbar>
    <HyperRTS.Editor.Validation.IssueList name="issues" grouped="true" />
  </HyperRTS.Editor.Hub.PageShell>
</ui:UXML>
