/* The Effects page. Colour tokens are in Common/HyperRTSEditor.uss. */

/* Sized by the window, not its content, so the list and the detail scroll inside it. */
.hrts-effects__split {
  flex-grow: 1;
  flex-basis: 0;
  min-height: 0;
}

/* The split sets the list's width, which a collection view's zero flex-basis would override. */
.hrts-effects__list {
  flex-basis: auto;
  flex-shrink: 0;
}

.hrts-effects__controls {
  padding: 4px;
}

.hrts-effects__title {
  -unity-font-style: bold;
  margin-bottom: 4px;
}

.hrts-effects__toggle {
  flex-grow: 0;
  margin-left: 8px;
}

.hrts-effects__name {
  margin-left: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hrts-effects__sheet {
  flex-direction: row;
  flex-wrap: wrap;
}

.hrts-effects__sheet-image {
  width: 240px;
  height: 135px;
  margin: 2px;
}
