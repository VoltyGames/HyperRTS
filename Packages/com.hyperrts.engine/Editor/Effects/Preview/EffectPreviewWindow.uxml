<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
  <Style src="../../Common/HyperRTSEditor.uss" />
  <Style src="EffectPreview.uss" />
  <ui:VisualElement class="hrts-effect-preview">
    <ui:VisualElement class="hrts-row">
      <uie:ObjectField name="rig" label="Rig" allow-scene-objects="false" class="hrts-row__grow" />
      <ui:Toggle name="follow" text="Follow selection" binding-path="effectPreview.follow" />
    </ui:VisualElement>
    <ui:Label name="hint" class="hrts-note" text="Pick an effect rig prefab, or select one in the Project window." />
    <ui:VisualElement name="controls" class="hrts-section hrts-hidden">
      <ui:VisualElement class="hrts-buttons">
        <ui:Button name="replay" text="Replay" />
        <ui:Toggle name="pause" text="Pause" class="hrts-effect-preview__toggle" />
        <ui:Toggle name="loop" text="Loop" binding-path="effectPreview.loop" class="hrts-effect-preview__toggle" />
      </ui:VisualElement>
      <uie:PropertyField binding-path="effectPreview.interval" label="Loop every (s)" />
      <uie:PropertyField name="scale" binding-path="effectPreview.scale" label="Scale" />
      <uie:PropertyField name="wind-strength" binding-path="effectPreview.windStrength" label="Wind strength" />
      <uie:PropertyField name="wind-heading" binding-path="effectPreview.windHeading" label="Wind heading" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
