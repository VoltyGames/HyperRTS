<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
  <uie:ToolbarButton name="maps" tooltip="Back to the map gallery.">
    <ui:VisualElement class="hrts-glyph hrts-glyph--map" picking-mode="Ignore" />
    <ui:Label text="Maps" picking-mode="Ignore" />
  </uie:ToolbarButton>
  <ui:Label name="map-name" class="hrts-map-toolbar__name" />
  <HyperRTS.Editor.Maps.Designer.Tools.MapToolStrip name="tools" />
  <uie:ToolbarSpacer class="hrts-fill" />
  <uie:ToolbarToggle name="ghosts" text="Ghosts" value="true" tooltip="Show the symmetry's other copies of each feature." />
  <HyperRTS.Editor.Maps.Designer.Window.MapPreviewStrip name="strip" class="hrts-map-toolbar__strip" />
</ui:UXML>
