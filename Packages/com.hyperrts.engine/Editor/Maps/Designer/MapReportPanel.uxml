<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
  <ui:Label name="source" class="hrts-section__title" />
  <ui:ScrollView class="hrts-map-report__content">
    <ui:Label name="empty" class="hrts-note" text="No preview or build yet." />
    <ui:VisualElement name="report">
      <HyperRTS.Editor.Common.TitledSection name="issues">
        <ui:VisualElement name="issue-rows" />
        <ui:Label name="no-issues" class="hrts-note" text="No issues." />
      </HyperRTS.Editor.Common.TitledSection>
      <HyperRTS.Editor.Common.TitledSection name="land" title="Land">
        <HyperRTS.Editor.Common.ValueList name="land-figures" />
      </HyperRTS.Editor.Common.TitledSection>
      <HyperRTS.Editor.Common.TitledSection name="metrics" title="Metrics (last build)">
        <HyperRTS.Editor.Common.ValueList name="metric-figures" />
      </HyperRTS.Editor.Common.TitledSection>
    </ui:VisualElement>
  </ui:ScrollView>
  <ui:VisualElement class="hrts-buttons">
    <ui:Button name="open-scene" text="Open scene" />
    <ui:Button name="recapture" text="Recapture views" />
  </ui:VisualElement>
</ui:UXML>
