<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
  <Style src="MapsPage.uss" />
  <HyperRTS.Editor.Hub.PageShell name="shell" empty-text="No map specs (*.map.json) in the project. New map... starts one.">
    <uie:Toolbar>
      <uie:ToolbarButton name="build-all" text="Build all" />
      <uie:ToolbarButton name="new-scene" text="New blank scene..." />
      <uie:ToolbarSpacer class="hrts-fill" />
    </uie:Toolbar>
    <ui:VisualElement name="specs" />
  </HyperRTS.Editor.Hub.PageShell>
</ui:UXML>
