/*
 * Editor glyphs from Lucide (ISC, see Credits.md): add hrts-glyph and one hrts-glyph--<name> class to a VisualElement.
 * The tint follows the editor text colour, so the light skin works; a state class can recolour it.
 */

:root {
  --hrts-glyph: var(--unity-colors-label-text);
}

.hrts-glyph {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
  -unity-background-image-tint-color: var(--hrts-glyph);
}

.hrts-glyph--brick-wall {
  background-image: url("Glyphs/BrickWall.svg");
}

.hrts-glyph--circle {
  background-image: url("Glyphs/Circle.svg");
}

.hrts-glyph--circle-x {
  background-image: url("Glyphs/CircleX.svg");
}

.hrts-glyph--cloud-fog {
  background-image: url("Glyphs/CloudFog.svg");
}

.hrts-glyph--eye {
  background-image: url("Glyphs/Eye.svg");
}

.hrts-glyph--eye-off {
  background-image: url("Glyphs/EyeOff.svg");
}

.hrts-glyph--folder-open {
  background-image: url("Glyphs/FolderOpen.svg");
}

.hrts-glyph--grid-3x3 {
  background-image: url("Glyphs/Grid3x3.svg");
}

.hrts-glyph--hammer {
  background-image: url("Glyphs/Hammer.svg");
}

.hrts-glyph--layers {
