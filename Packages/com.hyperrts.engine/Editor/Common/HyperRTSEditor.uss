.hrts-summary {
    margin: 0 0 4px 0;
}

.hrts-issue {
    flex-direction: row;
    align-items: stretch;
    margin: 1px 0;
}

.hrts-issue__context {
    width: 140px;
    margin: 0 2px 0 0;
}

.hrts-issue__message {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.hrts-issue__fix {
    width: 100px;
    margin: 0 0 0 2px;
    white-space: normal;
}

.hrts-section {
    margin-top: 8px;
}

.hrts-section__title {
    -unity-font-style: bold;
    margin: 0 0 2px 3px;
}

.hrts-row {
    flex-direction: row;
    align-items: center;
}

.hrts-row__grow {
    flex-grow: 1;
    flex-shrink: 1;
}

.hrts-swatch {
    width: 12px;
    height: 12px;
    margin: 0 4px 0 3px;
    border-radius: 2px;
    flex-shrink: 0;
}

.hrts-buttons {
    flex-direction: row;
    margin-top: 4px;
}

.hrts-buttons > * {
    flex-grow: 1;
}

.hrts-fill {
    flex-grow: 1;
}

.hrts-toolbar-label {
    -unity-text-align: middle-right;
    font-size: 10px;
    margin-right: 4px;
}

.hrts-note {
    margin: 4px;
}

.hrts-table__cell {
    margin: 0 2px;
}

.hrts-table__number {
    -unity-text-align: middle-right;
}

.hrts-tree__node {
    margin: 0 0 6px 0;
    padding: 4px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.4);
    border-radius: 3px;
}

.hrts-tree__name {
    -unity-font-style: bold;
}

.hrts-tree__line {
    margin-left: 8px;
    white-space: normal;
}

.hrts-tabs,
.hrts-tabs .unity-tab-view__content-container,
.hrts-tabs .unity-tab__content-container {
    flex-grow: 1;
}

.hrts-generate__run-all {
    height: 24px;
    margin: 4px 3px 4px 3px;
}

.hrts-generate__row {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
    padding: 3px;
    border-bottom-width: 1px;
    border-color: rgba(128, 128, 128, 0.25);
}

.hrts-generate__name {
    -unity-font-style: bold;
}

.hrts-generate__description {
    white-space: normal;
    opacity: 0.75;
}

.hrts-generate__run {
    width: 60px;
    flex-shrink: 0;
}

.hrts-tools {
    flex-direction: row;
    flex-grow: 1;
}

.hrts-sidebar {
    width: 160px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-color: rgba(128, 128, 128, 0.4);
}

.hrts-sidebar__item {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding: 0 6px;
}

.hrts-sidebar__title {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
}

.hrts-badge {
    min-width: 16px;
    height: 16px;
    padding: 0 5px;
    border-radius: 8px;
    background-color: rgb(196, 64, 56);
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hrts-page-host {
    flex-grow: 1;
    flex-shrink: 1;
}

.hrts-page {
    flex-grow: 1;
}

.hrts-page__body {
    padding: 4px;
}

.hrts-hint {
    margin: 4px;
}

.hrts-map__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 3px;
}

.hrts-map__build {
    width: 60px;
    flex-shrink: 0;
}

.hrts-issue-badge {
    margin: 0 0 4px 0;
}

.hrts-issue-badge__button {
    flex-direction: row;
    align-self: flex-start;
    margin: 0;
    padding: 1px 6px;
    border-radius: 8px;
}

.hrts-issue-badge__button--open {
    border-color: rgb(120, 120, 120);
}

.hrts-issue-badge__count {
    -unity-font-style: bold;
    margin: 0 3px;
    padding: 0;
}

.hrts-issue-badge__errors {
    color: rgb(255, 90, 80);
}

.hrts-issue-badge__warnings {
    color: rgb(255, 200, 60);
}

.hrts-issue-badge__notes {
    color: rgb(150, 190, 255);
}

.hrts-option {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.hrts-option__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
}

.hrts-option__icon {
    width: 18px;
    height: 18px;
    margin: 0 4px;
    flex-shrink: 0;
}

.hrts-option__summary {
    width: 45%;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    color: rgb(160, 160, 160);
    font-size: 10px;
}

.hrts-map-editor {
    flex-grow: 1;
}

.hrts-map-toolbar__picker {
    min-width: 160px;
}

.hrts-map-editor__body {
    flex-direction: row;
    flex-grow: 1;
}

.hrts-map-list {
    width: 200px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-color: rgba(128, 128, 128, 0.4);
}

.hrts-map-list__item {
    padding: 1px 4px 1px 16px;
}

.hrts-map-list__item:hover {
    background-color: rgba(128, 128, 128, 0.2);
}

.hrts-map-list__item--selected {
    background-color: rgba(62, 125, 231, 0.6);
}

.hrts-map-canvas {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgb(32, 34, 36);
}

.hrts-map-canvas__image {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.hrts-map-canvas__overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hrts-map-canvas__scale {
    position: absolute;
    left: 6px;
    bottom: 4px;
    color: rgba(255, 255, 255, 0.8);
}

.hrts-map-canvas__error {
    position: absolute;
    left: 6px;
    top: 4px;
    color: rgb(255, 110, 100);
    white-space: normal;
}

.hrts-map-inspector {
    width: 280px;
    flex-shrink: 0;
    padding: 4px;
    border-left-width: 1px;
    border-color: rgba(128, 128, 128, 0.4);
}

.hrts-library {
    flex-grow: 1;
}

.hrts-library__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 200px;
}

.hrts-library-types {
    width: 130px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-color: rgba(128, 128, 128, 0.4);
}

.hrts-library-items {
    width: 240px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-color: rgba(128, 128, 128, 0.4);
}

.hrts-library-items__search {
    width: auto;
    margin: 4px;
}

.hrts-library-item {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 4px;
}

.hrts-library-item__thumb {
    width: 36px;
    height: 36px;
    margin-right: 6px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 2px;
}

.hrts-library-item__swatch {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
}

.hrts-library-item__key {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hrts-library-item__key--broken {
    color: rgb(230, 90, 80);
}

.hrts-library-detail {
    flex-grow: 1;
    padding: 4px 8px;
}

.hrts-library-form__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.hrts-library-form__title {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-style: bold;
}

.hrts-library-form__dirty {
    margin-right: 6px;
    color: rgb(230, 170, 60);
    -unity-font-style: italic;
}

.hrts-library-form__fields {
    margin-bottom: 8px;
}

.hrts-library-asset--missing .unity-object-field__input {
    border-color: rgb(230, 90, 80);
}

.hrts-library-used {
    margin-top: 6px;
}

.hrts-library-used__item {
    -unity-text-align: middle-left;
}

.hrts-library-problems {
    height: 140px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-color: rgba(128, 128, 128, 0.4);
    padding: 2px 4px;
}

.hrts-map-tools {
    flex-direction: row;
    margin-left: 6px;
}

.hrts-map-tools__kind {
    min-width: 110px;
    margin: 0 2px;
}

.hrts-map__info {
    width: 130px;
    flex-shrink: 0;
    color: rgb(160, 160, 160);
}

.hrts-map__status {
    width: 150px;
    flex-shrink: 0;
}

.hrts-new-map {
    padding: 6px;
}

.hrts-new-map__error {
    margin: 4px 3px;
    color: rgb(255, 110, 100);
    white-space: normal;
}

.hrts-new-map__create {
    align-self: flex-end;
    width: 90px;
}

.hrts-map-editor__side {
    width: 300px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-color: rgba(128, 128, 128, 0.4);
}

.hrts-map-editor__side > .hrts-map-inspector {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    border-left-width: 0;
}

.hrts-map-report {
    max-height: 50%;
    flex-shrink: 0;
    padding: 4px;
    border-top-width: 1px;
    border-color: rgba(128, 128, 128, 0.4);
}

.hrts-map-report__content {
    flex-shrink: 1;
}

.hrts-map-report__show {
    width: 48px;
    margin: 0 0 0 2px;
}

.hrts-map-report__name {
    width: 90px;
    margin-left: 3px;
}

.hrts-map-toolbar__strip {
    flex-direction: row;
    align-items: center;
}

.hrts-map-toolbar__busy {
    color: rgb(255, 200, 60);
}

.hrts-map-key--missing {
    color: rgb(255, 110, 100);
}
