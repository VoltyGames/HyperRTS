/*
 * The shared editor layout: sections, rows, buttons, notes and the hide toggles, plus the colour tokens every
 * feature sheet uses. Each window, page or inspector keeps its own sheet beside its UXML.
 */

:root {
    --hrts-border: rgba(128, 128, 128, 0.4);
    --hrts-dim-text: rgb(160, 160, 160);
    --hrts-error: rgb(255, 90, 80);
    --hrts-warning: rgb(255, 200, 60);
}

.hrts-section {
    margin-top: 8px;
}

.hrts-section__title {
    -unity-font-style: bold;
    margin: 0 0 2px 3px;
}

.hrts-row {
    flex-direction: row;
    align-items: center;
}

.hrts-row__grow {
    flex-grow: 1;
    flex-shrink: 1;
}

.hrts-swatch {
    width: 12px;
    height: 12px;
    margin: 0 4px 0 3px;
    border-radius: 2px;
    flex-shrink: 0;
}

.hrts-buttons {
    flex-direction: row;
    margin-top: 4px;
}

.hrts-buttons > * {
    flex-grow: 1;
}

.hrts-fill {
    flex-grow: 1;
}

.hrts-toolbar-label {
    -unity-text-align: middle-right;
    font-size: 10px;
    margin-right: 4px;
}

.hrts-note {
    margin: 4px;
}

/* Last, so a toggle wins over any rule above that sets display or visibility. */
.hrts-hidden {
    display: none;
}

.hrts-invisible {
    visibility: hidden;
}
