// Grows row crop plants for RowCropBatch: Plant runs one thread per lattice spot of a job, dispatched as
// (spots / 64, 1, jobs), each spot picking its model variant; Count then writes the draw args and clears the counters.
// Lattice maths match RowCropSpots.Range; slot counting is in Scatter.hlsl and the field maths in RowCropField.hlsl.
#pragma kernel Plant
#pragma kernel Count

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

SamplerState sampler_LinearClamp;

#include "Packages/com.hyperrts.engine/Presentation/Environment/Trampling/Trample.hlsl"
#include "Packages/com.hyperrts.engine/Presentation/Environment/Vegetation/RowCrops/RowCropInstance.hlsl"
#include "Packages/com.hyperrts.engine/Presentation/Environment/Vegetation/Scatter/Scatter.hlsl"
#include "Packages/com.hyperrts.engine/Presentation/Environment/Vegetation/RowCrops/RowCropField.hlsl"
#include "Packages/com.hyperrts.engine/Presentation/Environment/Vegetation/Scatter/BuildingFootprints.hlsl"
#include "Packages/com.hyperrts.engine/Presentation/Environment/Ground/CraterSink.hlsl"
#include "Packages/com.hyperrts.engine/Presentation/Environment/Vegetation/Scatter/BurntPlants.hlsl"

#define CHANNEL_DENSITY 0u
#define CHANNEL_ACROSS 1u
#define CHANNEL_ALONG 2u
#define CHANNEL_SCALE 3u
#define CHANNEL_YAW 4u
#define CHANNEL_DROP 5u
#define CHANNEL_SHADE 6u
#define CHANNEL_EDGE 7u // and 8
#define CHANNEL_VARIANT 9u
#define CHANNEL_LEAN 10u
#define CHANNEL_LEAN_TURN 11u
#define CHANNEL_BAND 13u // 12 is RowCropSpots.TramlineChannel, 14 RowCropField.hlsl's CHANNEL_CANOPY
#define CHANNEL_SWATH 15u
#define WANDER_SALT 0x5BD1E995u
#define EDGE_DITHER 1.5 // metres the field lookup strays, so edges on the 1 m grid look ragged
#define LODS 2u // RowCropBands.Lods
#define TRAMLINE_VERGE 0.15 // metres added to a wheel line's half width for the thinnest plants
#define FADE_SHARE 0.15 // share of the draw distance over which plants shrink away

RWStructuredBuffer<RowCropInstance> _Instances;

float4 _Camera;      // xyz position, w draw distance
float4 _Planting;    // row spacing, plant spacing, jitter, yaw jitter (radians)
float4 _Size;        // min scale, max scale, lod0 distance, lod1 distance
float4 _Variety;     // lean, edge lean (radians), wander metres, 1 / wander length
float4 _Far;         // share of plants kept and their scale at the simple mesh's far edge, metres thinning starts at,
                     // metres before the simple mesh's far edge the plants hand over to the canopy
float _FacesRow;     // 1: plants face along their row; 0: they keep the model's heading (+Z north)
float _Density;      // the quality's share of plants
float _Stand;        // the crop's share of sown spots that came up
uint _Variants;

float2 Lean(uint hash, float edge, RowCropField field)
{
    float tilt = lerp(_Variety.x, _Variety.y, edge) * Channel(hash, CHANNEL_LEAN);
    float heading = Channel(hash, CHANNEL_LEAN_TURN) * 6.2831853;
    return (field.across * cos(heading) + field.along * sin(heading)) * sin(tilt);
}

// Slot = variant * LODS + lod. Plants past the slot's capacity are dropped and Count clamps the draw to it.
void Store(uint variant, uint lod, RowCropInstance grown)
{
    uint index;
    if (Claim(variant * LODS + lod, index))
    {
        _Instances[index] = grown;
    }
}

[numthreads(64, 1, 1)]
void Plant(uint3 id : SV_DispatchThreadID)
{
    ScatterJob job = _Jobs[id.z];
    if (id.x >= (uint)(job.count.x * job.count.y))
    {
        return;
    }

    int row = job.first.x + (int)(id.x % (uint)job.count.x);
    int plant = job.first.y + (int)(id.x / (uint)job.count.x);
    RowCropField field = _Fields[job.id];
    float2 spot = field.origin + field.across * (row * _Planting.x) + field.along * (plant * _Planting.y);
    if (!Owns(job.tileMin, spot))
    {
        return;
    }

    uint hash = Hash(field.seed, row, plant);
    if (Channel(hash, CHANNEL_DENSITY) >= _Density * _Stand)
    {
        return;
    }

    float2 stray = float2(Channel(hash, CHANNEL_EDGE), Channel(hash, CHANNEL_EDGE + 1u)) - 0.5;
    if (FieldAt(spot + stray * EDGE_DITHER) != (uint)job.id + 1u)
    {
        return;
    }

    float2 metres = float2(row * _Planting.x, plant * _Planting.y);
    float wander = (Noise(field.seed, WANDER_SALT, metres * _Variety.w) * 2.0 - 1.0) * _Variety.z;
    float across = (Channel(hash, CHANNEL_ACROSS) * 2.0 - 1.0) * _Planting.z * _Planting.x + wander;
    float stagger = RowStagger(field, row);
    float along = ((Channel(hash, CHANNEL_ALONG) * 2.0 - 1.0) * _Planting.z + stagger) * _Planting.y;
    if (OnTramline(field.tramlines, row * _Planting.x + across))
    {
        return;
    }

    bool swath = OnSwath(field.swaths, row * _Planting.x + across);
    if (swath && Channel(hash, CHANNEL_SWATH) >= field.swaths.z)
    {
        return;
    }

    float2 xz = spot + field.across * across + field.along * along;
    if (UnderBuilding(xz) || Channel(hash, CHANNEL_DROP) < BurntShare(xz))
    {
        return;
    }

    // On the undented ground: the vertex stage sinks plants into craters with everything else.
    float3 position = float3(xz.x, GroundHeight(xz) + CraterDepth(xz), xz.y);
    float range = length(position - _Camera.xyz);
    if (range >= _Camera.w || range >= _Size.w)
    {
        return;
    }

    // Over the canopy's fade-in each plant leaves at its own range, so the field hands over without a line.
    float handover = Handover(_Camera.xyz, position, _Size.w, _Far.w);
    if (Channel(hash, CHANNEL_CANOPY) < handover)
    {
        return;
    }

    // From the thinning start plants thin out, nested by the density channel, and the rest grow to cover the gaps.
    float thinning = saturate((range - _Far.z) / (_Size.w - _Far.z));
    if (Channel(hash, CHANNEL_DENSITY) >= _Density * _Stand * lerp(1.0, _Far.x, thinning))
    {
        return;
    }

    // Fatter far plants would close the wheel lines, so thinned plants keep a wider verge off them.
    float4 verge = field.tramlines;
    verge.z += TRAMLINE_VERGE * thinning;
    if (OnTramline(verge, row * _Planting.x + across))
    {
        return;
    }

    TrampleSample trample = SampleTrample(xz);
    if (trample.crop > 0.5 + 0.5 * Channel(hash, CHANNEL_DROP))
    {
        return;
    }

    float turn = (Channel(hash, CHANNEL_YAW) * 2.0 - 1.0) * _Planting.w;
    float fade = saturate((_Camera.w - range) / (FADE_SHARE * _Camera.w));
    RowCropInstance grown;
    grown.position = position;
    float growth = FieldGrowth(field, metres);
    // Probing the edge only pays when the field's edge grows or leans differently from its middle.
    bool edged = _Growth.w != 1.0 || _Variety.y != _Variety.x;
    float edge = edged ? Edge(spot, field) : 0.0;
    grown.scale = lerp(_Size.x, _Size.y, Channel(hash, CHANNEL_SCALE)) * growth * lerp(1.0, _Growth.w, edge) * lerp(1.0, _Far.y, thinning) * fade;
    float2 forward = _FacesRow > 0.5 ? field.along : float2(0.0, 1.0);
    float2 side = _FacesRow > 0.5 ? field.across : float2(1.0, 0.0);
    grown.facing = forward * cos(turn) + side * sin(turn);
    Lodged lodged = Lodging(field, metres);
    bool lodgedMore = lodged.amount * LODGED_BEND > trample.crop;
    grown.trampleDirection = lodgedMore ? lodged.direction : trample.direction;
    grown.bend = lodgedMore ? lodged.amount * LODGED_BEND : trample.crop;
    grown.shade = Channel(hash, CHANNEL_SHADE);
    grown.lean = Lean(hash, edge, field);
    float lodRange = BandRange(range, Channel(hash, CHANNEL_BAND));
    uint lod = (uint)(lodRange >= _Size.z);
    uint variant = min((uint)(Channel(hash, CHANNEL_VARIANT) * _Variants), _Variants - 1u);
    Store(variant, lod, grown);
}

[numthreads(1, 1, 1)]
void Count(uint3 id : SV_DispatchThreadID)
{
    CloseSlots();
}
