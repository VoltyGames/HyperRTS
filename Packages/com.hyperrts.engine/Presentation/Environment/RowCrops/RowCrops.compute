// Grows row crop plants for RowCropBatch: Plant runs one thread per lattice spot of a job, dispatched as
// (spots / 64, 1, jobs) once per model variant; Count then writes the draw args and clears the counters.
// Lattice maths match RowCropSpots.cs; hashes, noise and slot counting are in Scatter.hlsl.
#pragma kernel Plant
#pragma kernel Count

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

SamplerState sampler_LinearClamp;

#include "Packages/com.hyperrts.engine/Presentation/Environment/Trample.hlsl"
#include "Packages/com.hyperrts.engine/Presentation/Environment/RowCrops/RowCropInstance.hlsl"
#include "Packages/com.hyperrts.engine/Presentation/Environment/Scatter.hlsl"
#include "Packages/com.hyperrts.engine/Presentation/Environment/Grass/BuildingFootprints.hlsl"

#define CHANNEL_DENSITY 0u
#define CHANNEL_ACROSS 1u
#define CHANNEL_ALONG 2u
#define CHANNEL_SCALE 3u
#define CHANNEL_YAW 4u
#define CHANNEL_DROP 5u
#define CHANNEL_SHADE 6u
#define CHANNEL_EDGE 7u // and 8
#define CHANNEL_VARIANT 9u
#define CHANNEL_LEAN 10u
#define CHANNEL_LEAN_TURN 11u
#define WANDER_SALT 0x5BD1E995u
#define GROWTH_SALT 0x27D4EB2Fu
#define EDGE_REACH 1.5 // metres probed round a plant; a plant this near the field's edge leans the most
#define EDGE_DITHER 1.5 // metres the field lookup strays, so edges on the 1 m grid look ragged
#define FADE_SHARE 0.15 // share of the draw distance over which plants shrink away

struct RowCropField // RowCropField.cs, 32 bytes
{
    float2 origin;
    float2 along;
    float2 across;
    int crop;
    int seed;
};

struct RowCropJob // RowCropJob.cs, 28 bytes
{
    float2 tileMin;
    uint field;
    int2 first; // first (row, plant) whose spot can fall in the tile
    int2 count; // rows and plants from first
};

StructuredBuffer<RowCropField> _Fields;
StructuredBuffer<RowCropJob> _Jobs;
StructuredBuffer<uint> _Capacities; // instances each slot's buffer holds
Texture2D<float4> _FieldIds;

RWStructuredBuffer<RowCropInstance> _Full;
RWStructuredBuffer<RowCropInstance> _Simple;
RWStructuredBuffer<RowCropInstance> _Card;

float4 _FieldArea;   // x min, z min, texels per metre in x and z
float4 _FieldTexels; // field id texels across and deep
float4 _Camera;      // xyz position, w draw distance
float4 _Planting;      // row spacing, plant spacing, jitter, yaw jitter (radians)
float4 _Size;        // min scale, max scale, lod0 distance, lod1 distance
float4 _Variety;     // lean, edge lean (radians), wander metres, 1 / wander length
float4 _Growth;       // min and max growth scale, 1 / growth variation size
float4 _Variant;     // variant grown this dispatch, variant count, its first slot
float _FacesRow;     // 1: plants face along their row; 0: they keep the model's heading (+Z north)
float _Density;
uint _Slots;

uint FieldAt(float2 spot)
{
    int2 texel = (int2)floor((spot - _FieldArea.xy) * _FieldArea.zw);
    if (any(texel < 0) || any(texel >= (int2)_FieldTexels.xy))
    {
        return 0u;
    }

    float2 bytes = round(_FieldIds.Load(int3(texel, 0)).rg * 255.0);
    return (uint)bytes.x + (uint)bytes.y * 256u;
}

// Share of four probes round the spot that fall outside its field.
float Edge(float2 spot, RowCropField field, uint id)
{
    float outside = 0.0;
    outside += FieldAt(spot + field.across * EDGE_REACH) != id ? 1.0 : 0.0;
    outside += FieldAt(spot - field.across * EDGE_REACH) != id ? 1.0 : 0.0;
    outside += FieldAt(spot + field.along * EDGE_REACH) != id ? 1.0 : 0.0;
    outside += FieldAt(spot - field.along * EDGE_REACH) != id ? 1.0 : 0.0;
    return outside * 0.25;
}

float2 Lean(uint hash, float2 spot, RowCropField field, uint id)
{
    float edge = _Variety.y > _Variety.x ? Edge(spot, field, id) : 0.0;
    float tilt = lerp(_Variety.x, _Variety.y, edge) * Channel(hash, CHANNEL_LEAN);
    float heading = Channel(hash, CHANNEL_LEAN_TURN) * 6.2831853;
    return (field.across * cos(heading) + field.along * sin(heading)) * sin(tilt);
}

// Writes at the slot's next index; plants past its capacity are dropped and Count clamps the draw to it.
void Store(uint lod, RowCropInstance grown)
{
    uint slot = (uint)_Variant.z + lod;
    uint index;
    if (!Claim(slot, _Capacities[slot], index))
    {
        return;
    }

    if (lod == 0u)
    {
        _Full[index] = grown;
    }
    else if (lod == 1u)
    {
        _Simple[index] = grown;
    }
    else
    {
        _Card[index] = grown;
    }
}

[numthreads(64, 1, 1)]
void Plant(uint3 id : SV_DispatchThreadID)
{
    RowCropJob job = _Jobs[id.z];
    if (id.x >= (uint)(job.count.x * job.count.y))
    {
        return;
    }

    int row = job.first.x + (int)(id.x % (uint)job.count.x);
    int plant = job.first.y + (int)(id.x / (uint)job.count.x);
    RowCropField field = _Fields[job.field];
    float2 spot = field.origin + field.across * (row * _Planting.x) + field.along * (plant * _Planting.y);
    if (!Owns(job.tileMin, spot))
    {
        return;
    }

    uint hash = Hash(field.seed, row, plant);
    uint count = (uint)_Variant.y;
    if (min((uint)(Channel(hash, CHANNEL_VARIANT) * count), count - 1u) != (uint)_Variant.x)
    {
        return;
    }

    if (Channel(hash, CHANNEL_DENSITY) >= _Density)
    {
        return;
    }

    float2 stray = float2(Channel(hash, CHANNEL_EDGE), Channel(hash, CHANNEL_EDGE + 1u)) - 0.5;
    if (FieldAt(spot + stray * EDGE_DITHER) != job.field + 1u)
    {
        return;
    }

    float2 metres = float2(row * _Planting.x, plant * _Planting.y);
    float wander = (Noise(field.seed, WANDER_SALT, metres * _Variety.w) * 2.0 - 1.0) * _Variety.z;
    float across = (Channel(hash, CHANNEL_ACROSS) * 2.0 - 1.0) * _Planting.z * _Planting.x + wander;
    float along = (Channel(hash, CHANNEL_ALONG) * 2.0 - 1.0) * _Planting.z * _Planting.y;
    float2 xz = spot + field.across * across + field.along * along;
    if (UnderBuilding(xz))
    {
        return;
    }

    float3 position = float3(xz.x, GroundHeight(xz), xz.y);
    float range = length(position - _Camera.xyz);
    if (range >= _Camera.w)
    {
        return;
    }

    TrampleSample trample = SampleTrample(xz);
    if (trample.crop > 0.5 + 0.5 * Channel(hash, CHANNEL_DROP))
    {
        return;
    }

    float turn = (Channel(hash, CHANNEL_YAW) * 2.0 - 1.0) * _Planting.w;
    float fade = saturate((_Camera.w - range) / (FADE_SHARE * _Camera.w));
    RowCropInstance grown;
    grown.position = position;
    float growth = lerp(_Growth.x, _Growth.y, Noise(field.seed, GROWTH_SALT, metres * _Growth.z));
    grown.scale = lerp(_Size.x, _Size.y, Channel(hash, CHANNEL_SCALE)) * growth * fade;
    float2 forward = _FacesRow > 0.5 ? field.along : float2(0.0, 1.0);
    float2 side = _FacesRow > 0.5 ? field.across : float2(1.0, 0.0);
    grown.facing = forward * cos(turn) + side * sin(turn);
    grown.trampleDirection = trample.direction;
    grown.bend = trample.crop;
    grown.shade = Channel(hash, CHANNEL_SHADE);
    grown.lean = Lean(hash, spot, field, job.field + 1u);
    uint lod = range < _Size.z ? 0u : (range < _Size.w ? 1u : 2u);
    Store(lod, grown);
}

[numthreads(1, 1, 1)]
void Count(uint3 id : SV_DispatchThreadID)
{
    for (uint slot = 0u; slot < _Slots; slot++)
    {
        CloseSlot(slot, _Capacities[slot]);
    }
}
