// Test-only: samples an interaction map the way terrain, foliage, crop and water shaders do, at two world points.
#pragma kernel Probe

Texture2D<float4> _Source;
SamplerState sampler_LinearClamp;
RWStructuredBuffer<float> _Samples;
float4 _Rect;    // x min, z min, 1 / width, 1 / depth
float4 _Points;  // xy first point, zw second point (world XZ)
float4 _Channel; // picks the channel read: (1, 0, 0, 0) is R

[numthreads(1, 1, 1)]
void Probe(uint3 id : SV_DispatchThreadID)
{
    _Samples[0] = dot(_Source.SampleLevel(sampler_LinearClamp, (_Points.xy - _Rect.xy) * _Rect.zw, 0), _Channel);
    _Samples[1] = dot(_Source.SampleLevel(sampler_LinearClamp, (_Points.zw - _Rect.xy) * _Rect.zw, 0), _Channel);
}
