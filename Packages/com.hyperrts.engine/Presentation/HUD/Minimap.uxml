<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement class="hud-minimap hud-panel">
    <ui:VisualElement name="canvas" class="hud-minimap__canvas">
      <ui:VisualElement name="fog" class="hud-minimap__fog" picking-mode="Ignore" />
      <ui:VisualElement name="markers" class="hud-minimap__markers" picking-mode="Ignore" />
      <ui:VisualElement name="view" class="hud-minimap__view" picking-mode="Ignore" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
