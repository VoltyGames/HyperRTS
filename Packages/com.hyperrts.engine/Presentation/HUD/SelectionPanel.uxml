<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement class="hud-selection hud-panel">
    <ui:VisualElement name="single" class="hud-single">
      <ui:VisualElement class="hud-single__header">
        <ui:VisualElement class="hud-single__icon-slot">
          <HyperRTS.Presentation.HUD.HUDIcon name="icon" class="hud-single__icon" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-single__details">
          <ui:Label name="name" class="hud-single__name" />
          <HyperRTS.Presentation.HUD.HUDBar name="health" class="hud-health" />
          <ui:Label name="health-text" class="hud-single__caption" />
          <HyperRTS.Presentation.HUD.HUDBar name="construction" class="hud-construction" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="queue" class="hud-queue" />
    </ui:VisualElement>
    <ui:VisualElement name="groups" class="hud-groups" />
  </ui:VisualElement>
</ui:UXML>
