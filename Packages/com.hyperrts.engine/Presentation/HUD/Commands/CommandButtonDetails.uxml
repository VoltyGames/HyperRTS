<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <HyperRTS.Presentation.HUD.HUDSweep name="sweep" class="hud-command__sweep" />
  <ui:VisualElement class="hud-command__badges" picking-mode="Ignore">
    <HyperRTS.Presentation.HUD.HUDGlyph shape="Padlock" class="hud-command__lock" />
    <ui:Label name="count" class="hud-command__count" />
    <HyperRTS.Presentation.HUD.HUDGlyph name="unpowered" shape="Lightning" class="hud-command__unpowered" />
  </ui:VisualElement>
  <HyperRTS.Presentation.HUD.HUDFade class="hud-command__strip">
    <HyperRTS.Presentation.HUD.Commands.CostRow name="costs" picking-mode="Ignore" />
    <ui:Label name="limit" class="hud-command__limit" />
  </HyperRTS.Presentation.HUD.HUDFade>
</ui:UXML>
