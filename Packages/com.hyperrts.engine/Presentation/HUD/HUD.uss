/* HyperRTS in-game HUD layout: positions, sizes, spacing on an 8px rhythm, icon scaling and disabled state. The look
   is in HUDTheme.uss. */

@import url("HUDCommands.uss");

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --hud-inset: 8px;
    --hud-panel-padding: 8px;
    --hud-minimap-size: 208px;
    --hud-bottom-height: 246px;
    --hud-icon-size: 72px;
    --hud-slot-size: 48px;
    --hud-group-size: 52px;
    --hud-resource-icon-size: 20px;
    --hud-resource-gap: 16px;
}

.hrts-hidden { display: none; }

/* Keeps the element's space, so neighbouring panels don't shift. */
.hrts-invisible { visibility: hidden; }

.hud-panel {
    padding: var(--hud-panel-padding);
}

.hud-icon {
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-icon__initials {
    padding: 0;
    margin: 0;
}

.hud-bar {
    height: 8px;
    overflow: hidden;
}

.hud-bar__fill {
    height: 100%;
    width: 0;
}

/* Top bar */

.hud-topbar {
    position: absolute;
    top: var(--hud-inset);
    right: var(--hud-inset);
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
}

.hud-topbar__resources {
    flex-direction: row;
    align-items: center;
}

.hud-resource {
    flex-direction: row;
    align-items: center;
    margin-left: var(--hud-resource-gap);
}

.hud-resource__icon {
    width: var(--hud-resource-icon-size);
    height: var(--hud-resource-icon-size);
    margin-right: 6px;
}

.hud-resource__name {
    margin-right: 6px;
    padding: 0;
}

.hud-resource__amount {
    min-width: 48px;
    padding: 0;
}

/* Bottom row */

.hud-bottom {
    position: absolute;
    left: var(--hud-inset);
    right: var(--hud-inset);
    bottom: var(--hud-inset);
    flex-direction: row;
    align-items: flex-end;
}

.hud-minimap {
    width: var(--hud-minimap-size);
    height: var(--hud-minimap-size);
    padding: 4px;
}

.hud-minimap__canvas {
    flex-grow: 1;
    overflow: hidden;
}

.hud-minimap__fog {
    -unity-background-image-tint-color: black;
    --minimap-explored-alpha: 0.431;
    --minimap-unexplored-alpha: 0.843;
}

.hud-minimap__markers {
    --minimap-outline-color: rgba(0, 0, 0, 0.7);
    --minimap-outline-width: 1;
    --minimap-unit-radius: 2.2;
    --minimap-structure-radius: 3.2;
    --minimap-node-radius: 2.4;
}

.hud-minimap__view {
    --minimap-view-color: rgba(255, 255, 255, 0.85);
    --minimap-view-width: 1.5;
}

.hud-minimap__fog,
.hud-minimap__markers,
.hud-minimap__view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-selection {
    flex-grow: 1;
    max-width: 560px;
    min-height: 120px;
    margin: 0 8px;
}

.hud-single__header {
    flex-direction: row;
}

.hud-single__icon {
    width: var(--hud-icon-size);
    height: var(--hud-icon-size);
}

.hud-single__details {
    flex-grow: 1;
    margin-left: 12px;
    justify-content: center;
}

.hud-single__name {
    padding: 0;
    margin-bottom: 6px;
}

.hud-single__caption {
    padding: 0;
    margin-top: 3px;
}

.hud-single__health {
    height: 10px;
}

.hud-single__construction {
    margin-top: 6px;
}

/* Production queue */

.hud-single__queue {
    flex-direction: row;
    margin-top: 10px;
}

.hud-slot {
    width: var(--hud-slot-size);
    height: var(--hud-slot-size);
    margin: 0 6px 0 0;
    padding: 0;
}

.hud-slot__icon {
    flex-grow: 1;
}

.hud-slot__progress {
    position: absolute;
    left: 3px;
    right: 3px;
    bottom: 3px;
    height: 5px;
}

/* Group tiles */

.hud-single__groups {
    flex-direction: row;
    flex-wrap: wrap;
}

.hud-group {
    width: var(--hud-group-size);
    height: var(--hud-group-size);
    margin: 0 6px 6px 0;
}

.hud-group__icon {
    flex-grow: 1;
}

.hud-group__count {
    position: absolute;
    right: 2px;
    bottom: 0;
    padding: 0 2px;
}

/* Game over */

.hud-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 28%;
    align-items: center;
}

.hud-banner__title {
    padding: 12px 64px;
}

/* Strategic asset countdowns, top centre */

.hud-countdowns {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    align-items: center;
}

.hud-countdowns__row {
    padding: 2px 10px;
    margin-bottom: 2px;
}

/* Line cost, above and right of the dragged line's end; PlaceBeside moves both by translate */

.hud-line-cost {
    position: absolute;
    left: 0;
    top: 0;
    padding: 2px 6px;
}

.hud-placement-hint {
    position: absolute;
    left: 0;
    top: 0;
    padding: 2px 6px;
}

.hud-drag-box {
    position: absolute;
    left: 0;
    top: 0;
    border-width: 2px;
}

/* An 18px L from two 4px borders, set over the box's 2px edge; panel px scale with resolution and UI scale. */
.hud-drag-box__corner {
    position: absolute;
    width: 18px;
    height: 18px;
}

.hud-drag-box__corner--tl, .hud-drag-box__corner--bl { left: -2px; border-left-width: 4px; }

.hud-drag-box__corner--tr, .hud-drag-box__corner--br { right: -2px; border-right-width: 4px; }

.hud-drag-box__corner--tl, .hud-drag-box__corner--tr { top: -2px; border-top-width: 4px; }

.hud-drag-box__corner--bl, .hud-drag-box__corner--br { bottom: -2px; border-bottom-width: 4px; }
