/* HyperRTS in-game HUD layout: positions, sizes, spacing on an 8px rhythm, icon scaling and disabled state. The look
   is in HUDTheme.uss. */

@import url("HUDCommands.uss");

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hrts-hidden { display: none; }

/* Keeps the element's space, so neighbouring panels don't shift. */
.hrts-invisible { visibility: hidden; }

.hud-panel {
    padding: 8px;
}

.hud-icon {
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-icon__initials {
    padding: 0;
    margin: 0;
}

.hud-bar {
    height: 8px;
    overflow: hidden;
}

.hud-bar__fill {
    height: 100%;
    width: 0;
}

/* Top bar */

.hud-topbar {
    position: absolute;
    top: 8px;
    right: 8px;
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
}

.hud-topbar__resources {
    flex-direction: row;
    align-items: center;
}

.hud-resource {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
}

.hud-resource__icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
}

.hud-resource__name {
    margin-right: 6px;
    padding: 0;
}

.hud-resource__amount {
    min-width: 48px;
    padding: 0;
}

/* Bottom row */

.hud-bottom {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    flex-direction: row;
    align-items: flex-end;
}

.hud-minimap {
    width: 208px;
    height: 208px;
    padding: 4px;
}

.hud-minimap__canvas {
    flex-grow: 1;
    overflow: hidden;
}

.hud-minimap__fog,
.hud-minimap__blips,
.hud-minimap__view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-selection {
    flex-grow: 1;
    max-width: 560px;
    min-height: 120px;
    margin: 0 8px;
}

.hud-single__header {
    flex-direction: row;
}

.hud-single__icon {
    width: 72px;
    height: 72px;
}

.hud-single__details {
    flex-grow: 1;
    margin-left: 12px;
    justify-content: center;
}

.hud-single__name {
    padding: 0;
    margin-bottom: 6px;
}

.hud-single__caption {
    padding: 0;
    margin-top: 3px;
}

.hud-health {
    height: 10px;
}

.hud-construction {
    margin-top: 6px;
}

/* Production queue */

.hud-queue {
    flex-direction: row;
    margin-top: 10px;
}

.hud-slot {
    width: 48px;
    height: 48px;
    margin: 0 6px 0 0;
    padding: 0;
}

.hud-slot__icon {
    flex-grow: 1;
}

.hud-slot__progress {
    position: absolute;
    left: 3px;
    right: 3px;
    bottom: 3px;
    height: 5px;
}

/* Group tiles */

.hud-groups {
    flex-direction: row;
    flex-wrap: wrap;
}

.hud-group {
    width: 52px;
    height: 52px;
    margin: 0 6px 6px 0;
}

.hud-group__icon {
    flex-grow: 1;
}

.hud-group__count {
    position: absolute;
    right: 2px;
    bottom: 0;
    padding: 0 2px;
}

/* Game over */

.hud-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 28%;
    align-items: center;
}

.hud-banner__title {
    padding: 12px 64px;
}

/* Line cost, above and right of the dragged line's end */

.hud-line-cost {
    position: absolute;
    translate: 0 -100%;
    padding: 2px 6px;
}

.drag-box {
    position: absolute;
    border-width: 2px;
}

/* An 18px L from two 4px borders, set over the box's 2px edge; panel px scale with resolution and UI scale. */
.drag-box__corner {
    position: absolute;
    width: 18px;
    height: 18px;
}

.drag-box__corner--tl, .drag-box__corner--bl { left: -2px; border-left-width: 4px; }

.drag-box__corner--tr, .drag-box__corner--br { right: -2px; border-right-width: 4px; }

.drag-box__corner--tl, .drag-box__corner--tr { top: -2px; border-top-width: 4px; }

.drag-box__corner--bl, .drag-box__corner--br { bottom: -2px; border-bottom-width: 4px; }
