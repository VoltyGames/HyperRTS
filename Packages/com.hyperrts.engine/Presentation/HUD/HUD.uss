/* HyperRTS in-game HUD layout: positions, sizes and spacing on an 8px rhythm. The look is in HUDTheme.uss. */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-panel {
    padding: 8px;
}

.hud-icon {
    align-items: center;
    justify-content: center;
}

.hud-icon__initials {
    padding: 0;
    margin: 0;
}

.hud-bar {
    height: 8px;
    overflow: hidden;
}

.hud-bar__fill {
    height: 100%;
    width: 0;
}

/* Top bar */

.hud-topbar {
    position: absolute;
    top: 8px;
    right: 8px;
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
}

.hud-topbar__resources {
    flex-direction: row;
    align-items: center;
}

.hud-resource {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
}

.hud-resource__icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
}

.hud-resource__name {
    margin-right: 6px;
    padding: 0;
}

.hud-resource__amount {
    min-width: 48px;
    padding: 0;
}

/* Bottom row */

.hud-bottom {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    flex-direction: row;
    align-items: flex-end;
}

.hud-minimap {
    width: 208px;
    height: 208px;
    padding: 4px;
}

.hud-minimap__canvas {
    flex-grow: 1;
    overflow: hidden;
}

.hud-minimap__fog,
.hud-minimap__blips,
.hud-minimap__view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-selection {
    flex-grow: 1;
    max-width: 560px;
    min-height: 120px;
    margin: 0 8px;
}

.hud-single__header {
    flex-direction: row;
}

.hud-single__icon {
    width: 72px;
    height: 72px;
}

.hud-single__details {
    flex-grow: 1;
    margin-left: 12px;
    justify-content: center;
}

.hud-single__name {
    padding: 0;
    margin-bottom: 6px;
}

.hud-single__caption {
    padding: 0;
    margin-top: 3px;
}

.hud-health {
    height: 10px;
}

.hud-construction {
    margin-top: 6px;
}

/* Production queue */

.hud-queue {
    flex-direction: row;
    margin-top: 10px;
}

.hud-slot {
    width: 48px;
    height: 48px;
    margin: 0 6px 0 0;
    padding: 0;
}

.hud-slot__icon {
    flex-grow: 1;
}

.hud-slot__progress {
    position: absolute;
    left: 3px;
    right: 3px;
    bottom: 3px;
    height: 5px;
}

/* Group tiles */

.hud-groups {
    flex-direction: row;
    flex-wrap: wrap;
}

.hud-group {
    width: 52px;
    height: 52px;
    margin: 0 6px 6px 0;
}

.hud-group__icon {
    flex-grow: 1;
}

.hud-group__count {
    position: absolute;
    right: 2px;
    bottom: 0;
    padding: 0 2px;
}

/* Command card */

.hud-commands {
    width: 264px;
    min-height: 120px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.hud-command {
    width: 80px;
    height: 72px;
    margin: 3px;
    padding: 3px;
    align-items: center;
    justify-content: flex-start;
    white-space: normal;
}

.hud-command--text {
    height: 32px;
    justify-content: center;
}

.hud-command__icon {
    width: 36px;
    height: 36px;
}

.hud-command__cooldown {
    position: absolute;
    top: 3px;
    right: 5px;
}

.hud-command__hotkey {
    position: absolute;
    top: 3px;
    left: 5px;
}

.hud-command__name {
    padding: 0;
    margin-top: 2px;
    -unity-text-align: middle-center;
    overflow: hidden;
    max-width: 72px;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.hud-costs {
    flex-direction: row;
}

.hud-costs__amount {
    padding: 0 2px;
}

/* Game over */

.hud-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 28%;
    align-items: center;
}

.hud-banner__title {
    padding: 12px 64px;
}
