<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement class="hud-selection hud-panel">
    <ui:VisualElement name="single">
      <ui:VisualElement class="hud-single__header">
        <HyperRTS.Presentation.HUD.HUDIcon name="icon" class="hud-single__icon" />
        <ui:VisualElement class="hud-single__details">
          <ui:Label name="name" class="hud-single__name" />
          <HyperRTS.Presentation.HUD.HUDBar name="health" class="hud-single__health" />
          <ui:Label name="health-text" class="hud-single__caption" />
          <HyperRTS.Presentation.HUD.HUDBar name="construction" class="hud-single__construction" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="squad" class="hud-squad">
        <ui:VisualElement name="members" class="hud-squad__members" />
        <ui:VisualElement class="hud-squad__row">
          <HyperRTS.Presentation.HUD.HUDBar name="suppression" class="hud-squad__suppression" />
          <ui:Label name="level" class="hud-squad__level" />
        </ui:VisualElement>
        <ui:VisualElement name="status" class="hud-squad__row">
          <ui:Label name="status-text" class="hud-squad__level" />
          <HyperRTS.Presentation.HUD.HUDBar name="progress" class="hud-squad__progress" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="queue" class="hud-single__queue" />
    </ui:VisualElement>
    <ui:VisualElement name="groups" class="hud-single__groups" />
  </ui:VisualElement>
</ui:UXML>
