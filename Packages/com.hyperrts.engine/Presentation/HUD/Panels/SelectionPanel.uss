.hud-selection {
  flex-grow: 1;
  max-width: 560px;
  min-height: 120px;
  margin: 0 8px;
}

.hud-single__header {
  flex-direction: row;
}

.hud-single__icon {
  width: var(--hud-icon-size);
  height: var(--hud-icon-size);
}

.hud-single__details {
  flex-shrink: 0;
  width: 200px;
  margin-left: 12px;
  justify-content: center;
}

.hud-details {
  flex-grow: 1;
  flex-direction: row;
  align-items: flex-start;
  margin-left: 16px;
}

.hud-details__column {
  flex-grow: 1;
  flex-basis: 0;
  margin-right: 16px;
}

.hud-detail {
  margin-bottom: 3px;
}

.hud-detail .hud-tooltip__stat-name {
  margin-right: 10px;
}

.hud-detail .hud-tooltip__stat-value {
  flex-shrink: 1;
  white-space: normal;
  -unity-text-align: upper-right;
}

.hud-detail__chevrons {
  flex-direction: row;
}

.hud-detail__chevron {
  width: 12px;
  height: 12px;
  margin-left: -2px;
}

.hud-single__name {
  padding: 0;
  margin-bottom: 6px;
}

.hud-single__caption {
  padding: 0;
  margin-top: 3px;
}

.hud-single__health {
  height: 10px;
}

.hud-single__construction {
  margin-top: 6px;
}

.hud-single__queue {
  flex-direction: row;
  margin-top: 10px;
}

.hud-single__groups {
  flex-direction: row;
  flex-wrap: wrap;
}

.hud-group {
  width: var(--hud-group-size);
  height: var(--hud-group-size);
  margin: 0 6px 6px 0;
}

.hud-group__icon {
  flex-grow: 1;
}

.hud-group__count {
  position: absolute;
  right: 2px;
  bottom: 0;
  padding: 0 2px;
}
