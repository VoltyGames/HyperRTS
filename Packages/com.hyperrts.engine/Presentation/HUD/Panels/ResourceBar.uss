.hud-topbar {
    position: absolute;
    top: var(--hud-inset);
    right: var(--hud-inset);
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
}

.hud-topbar__resources {
    flex-direction: row;
    align-items: center;
}

.hud-resource {
    flex-direction: row;
    align-items: center;
    margin-left: var(--hud-resource-gap);
}

.hud-resource__icon {
    width: var(--hud-resource-icon-size);
    height: var(--hud-resource-icon-size);
    margin-right: 6px;
}

.hud-resource__name {
    margin-right: 6px;
    padding: 0;
}

.hud-resource__amount {
    min-width: 48px;
    padding: 0;
}
