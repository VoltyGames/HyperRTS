/* HyperRTS default HUD look: dark translucent panels. Layout is in HUD.uss. A game restyles the HUD by overriding the
   --hud-* properties below on .hud-root in a sheet that imports this one (see docs/extending.md). */

.hud-root {
    --hud-text: rgb(228, 232, 238);
    --hud-text-muted: rgb(150, 160, 175);
    --hud-panel-bg: rgba(12, 16, 22, 0.82);
    --hud-tooltip-bg: rgba(12, 16, 22, 0.94);
    --hud-overlay-bg: rgba(8, 10, 14, 0.75);
    --hud-badge-bg: rgba(0, 0, 0, 0.7);
    --hud-line: rgba(255, 255, 255, 0.08);
    --hud-line-strong: rgba(255, 255, 255, 0.12);
    --hud-tile-bg: rgba(255, 255, 255, 0.06);
    --hud-radius: 6px;
    --hud-radius-small: 4px;
    --hud-radius-tiny: 3px;
    --hud-card-bg: rgba(255, 255, 255, 0.06);
    --hud-card-bg-hover: rgba(255, 255, 255, 0.14);
    --hud-card-bg-active: rgba(120, 200, 255, 0.25);
    --hud-card-line: rgba(255, 255, 255, 0.1);
    --hud-card-line-hover: rgba(120, 200, 255, 0.7);
    --hud-card-active-line: rgb(110, 220, 120);
    --hud-card-active-bg: rgba(110, 220, 120, 0.18);
    --hud-card-queued-line: rgb(110, 220, 120);
    --hud-card-queued-bg: rgba(110, 220, 120, 0.18);
    --hud-card-picture-bg: rgb(34, 40, 48);
    --hud-card-picture-bg-hover: rgb(46, 54, 64);
    --hud-resource-amount: var(--hud-text);
    --hud-warn: rgb(255, 184, 56);
    --hud-danger: rgb(255, 95, 80);
    --hud-bar-health: rgb(82, 214, 96);
    --hud-bar-build: rgb(240, 190, 60);
    --hud-bar-progress: rgb(90, 180, 255);
    color: var(--hud-text);
    font-size: 13px;
}

.hud-panel {
    background-color: var(--hud-panel-bg);
    border-width: 1px;
    border-color: var(--hud-line);
    border-radius: var(--hud-radius);
}

/* Only a tile without a picture, so a transparent icon sits straight on its panel. */
.hud-icon--empty {
    background-color: var(--hud-tile-bg);
    border-radius: var(--hud-radius-small);
}

.hud-icon__initials {
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(170, 180, 195);
}

.hud-bar {
    --bar-fill: var(--hud-bar-health);
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: var(--hud-radius-tiny);
}

.hud-bar__fill {
    background-color: var(--bar-fill);
}

/* Top bar */

.hud-resource__name {
    font-size: 11px;
    color: var(--hud-text-muted);
}

.hud-resource__amount {
    color: var(--hud-resource-amount);
    font-size: 15px;
    -unity-font-style: bold;
}

.hud-resource__amount--full {
    color: var(--hud-danger);
}

.hud-resource__amount--low-power {
    color: var(--hud-warn);
}

/* Bottom row */

.hud-minimap__canvas {
    background-color: rgba(30, 42, 34, 0.9);
    border-radius: var(--hud-radius-small);
}

.hud-single__icon {
    border-bottom-width: 3px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
}

.hud-single__name {
    font-size: 17px;
    -unity-font-style: bold;
}

.hud-single__caption {
    font-size: 11px;
    color: var(--hud-text-muted);
}

.hud-single__construction {
    --bar-fill: var(--hud-bar-build);
}

/* Production queue */

.hud-slot {
    border-width: 1px;
    border-color: var(--hud-line-strong);
    border-radius: var(--hud-radius-small);
    background-color: rgba(255, 255, 255, 0.05);
}

.hud-slot:hover {
    border-color: rgb(255, 110, 90);
}

.hud-slot__progress {
    --bar-fill: var(--hud-bar-progress);
}

/* Group tiles */

.hud-group__count {
    font-size: 12px;
    -unity-font-style: bold;
    background-color: var(--hud-badge-bg);
    border-radius: var(--hud-radius-tiny);
}

/* Command card */

.hud-command {
    color: var(--hud-text);
    background-color: var(--hud-card-bg);
    border-width: 1px;
    border-color: var(--hud-card-line);
    border-radius: var(--hud-radius-small);
    font-size: 11px;
}

/* Solid, so a transparent icon reads as well as a full-bleed one. */
.hud-command--picture {
    background-color: var(--hud-card-picture-bg);
}

.hud-command:hover {
    background-color: var(--hud-card-bg-hover);
    border-color: var(--hud-card-line-hover);
}

.hud-command--picture:hover {
    background-color: var(--hud-card-picture-bg-hover);
}

.hud-command:active {
    background-color: var(--hud-card-bg-active);
}

.hud-command--active {
    border-color: var(--hud-card-active-line);
    background-color: var(--hud-card-active-bg);
}

.hud-command--queued {
    border-color: var(--hud-card-queued-line);
    background-color: var(--hud-card-queued-bg);
}

.hud-command--unaffordable .hud-command__icon {
    opacity: 0.75;
}

.hud-command--locked .hud-command__icon,
.hud-command--researched .hud-command__icon {
    filter: grayscale(1);
    opacity: 0.4;
}

.hud-command--maxed .hud-command__icon {
    opacity: 0.5;
}

.hud-command--maxed .hud-command__limit,
.hud-costs--short .hud-costs__amount {
    color: var(--hud-danger);
}

.hud-command__lock {
    color: var(--hud-text);
    background-color: var(--hud-badge-bg);
}

.hud-command__chevron {
    color: var(--hud-text);
}

.hud-command__caption {
    font-size: 12px;
    -unity-font-style: bold;
}

.hud-command__unpowered {
    color: var(--hud-warn);
}

.hud-command__sweep {
    --sweep-color: rgba(0, 0, 0, 0.55);
}

.hud-command__strip {
    --fade-color: rgba(0, 0, 0, 0.85);
}

.hud-command__count {
    font-size: 12px;
    -unity-font-style: bold;
    background-color: var(--hud-badge-bg);
    border-radius: var(--hud-radius-tiny);
}

.hud-command__limit {
    font-size: 10px;
    -unity-font-style: bold;
}

.hud-command__cooldown {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 210, 120);
}

.hud-command__hotkey {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.7);
}

.hud-command__name {
    font-size: 10px;
}

.hud-costs__amount {
    font-size: 10px;
    -unity-font-style: bold;
}

/* Tooltip */

.hud-tooltip {
    background-color: var(--hud-tooltip-bg);
    border-width: 1px;
    border-color: var(--hud-line-strong);
    border-radius: var(--hud-radius);
    font-size: 12px;
}

.hud-tooltip__title {
    font-size: 14px;
    -unity-font-style: bold;
}

.hud-tooltip__line {
    color: rgb(190, 198, 210);
}

.hud-tooltip__line--warning {
    color: var(--hud-danger);
}

.hud-tooltip__stat-name {
    color: var(--hud-text-muted);
}

/* Game over */

.hud-banner__title {
    font-size: 72px;
    -unity-font-style: bold;
    background-color: var(--hud-overlay-bg);
    border-radius: 8px;
    letter-spacing: 8px;
}

.hud-banner__title--victory {
    color: rgb(120, 230, 130);
}

.hud-banner__title--defeat {
    color: var(--hud-danger);
}

.hud-countdowns__row {
    font-size: 16px;
    -unity-font-style: bold;
    background-color: var(--hud-overlay-bg);
    border-radius: var(--hud-radius-small);
}

.hud-countdowns__row--ready {
    border-width: 1px;
    border-color: var(--hud-warn);
}

.hud-line-cost {
    background-color: var(--hud-overlay-bg);
    border-radius: var(--hud-radius-small);
}

.hud-line-cost .hud-costs__amount {
    font-size: 14px;
}

.hud-placement-hint {
    background-color: var(--hud-overlay-bg);
    border-radius: var(--hud-radius-small);
    color: rgb(220, 226, 235);
    font-size: 12px;
}

/* The box sits beside .hud-root, so it carries its own properties. */
.hud-drag-box {
    --hud-drag-fill: rgba(200, 225, 255, 0.1);
    --hud-drag-line: rgba(200, 225, 255, 0.9);
    --hud-drag-corner: rgb(225, 238, 255);
    background-color: var(--hud-drag-fill);
    border-color: var(--hud-drag-line);
}

.hud-drag-box__corner {
    border-color: var(--hud-drag-corner);
}
