/* HyperRTS default HUD look: dark translucent panels. Layout is in HUD.uss. A game restyles the HUD by overriding the
   --hud-* properties below on .hud-root in a sheet that imports this one (see docs/extending.md). */

@import url("HUDBaseTheme.uss");
@import url("Panels/ResourceBarTheme.uss");
@import url("Map/MinimapTheme.uss");
@import url("Panels/SelectionPanelTheme.uss");
@import url("Panels/SquadViewTheme.uss");
@import url("Panels/ProductionQueueViewTheme.uss");
@import url("Commands/CommandCardTheme.uss");
@import url("Commands/CostRowTheme.uss");
@import url("HUDTooltipTheme.uss");
@import url("GameOverBannerTheme.uss");
@import url("StrategicCountdownsTheme.uss");
@import url("Commands/LineCostTheme.uss");
@import url("PlacementHintTheme.uss");
@import url("SelectionDragBoxUITheme.uss");
